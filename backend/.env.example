GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration (digunakan oleh Asynq message queue)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Worker Configuration
WORKER_COUNT=3

# HTTP Server
PORT=:8080

# YouTube Data API v3 (OAuth2) - untuk upload clip ke channel
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials > OAuth client ID (tipe: Web application)
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret
# Harus sama persis dengan "Authorized redirect URI" di Google Cloud Console
YOUTUBE_REDIRECT_URL=http://localhost:8080/api/youtube/callback
